# Copy this file to .env and fill in real values. .env is gitignored;
# this template is safe to commit.

# postgresql://<user>:<password>@<host>:5432/pfmea_agent
DATABASE_URL=

# Needed by cluster_pfmea_files (NORMALIZER + embeddings) and anything else
# that calls the OpenAI API.
OPENAI_API_KEY=

# Shared secret required by mcp_server/server.py's HTTP mode (--transport http).
# Every request must send it as: Authorization: Bearer <this value>.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_HTTP_TOKEN=
